# Local frontend connection created by `npx convex dev`.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Chosen later, then stored with `npx convex env set` rather than in this file.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_BASE_URL=

# Stable temporary auth. Matching accounts can claim the buyer role.
BUYER_EMAIL=

# New-company alerts. Store secrets in Convex; never use VITE_ for these.
ALERT_EMAIL_URL=
ALERT_EMAIL_SECRET=
APP_URL=

# Sales connections. Set these on the intended Convex deployment, never VITE_.
# SALES_CREDENTIAL_KEY is a random 32-byte key, encoded as base64.
SALES_CREDENTIAL_KEY=
# Optional public HTTPS callback origin for a local test tunnel.
# Leave unset on a hosted deployment to use CONVEX_SITE_URL.
SALES_CALLBACK_BASE_URL=
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_SANDBOX=true
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
